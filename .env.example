NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Public origin for email links and magic-link sign-in. Defaults to https://gykeys.com.
# A vercel.app value is ignored. Canonicals and the sitemap stay on https://gykeys.com.
NEXT_PUBLIC_SITE_URL=https://gykeys.com
ADMIN_EMAILS=
RESEND_API_KEY=
ALERT_FROM_EMAIL=
WASENDER_API_KEY=
GUYANA_KEYS_SAMPLE_DATA=
# Set to 1 to open the isolated /preview desk. Leave unset on production.
PREVIEW_DESK=
# Signs saved-search unsubscribe links. Required for those links. No fallback.
ALERTS_TOKEN_SECRET=
